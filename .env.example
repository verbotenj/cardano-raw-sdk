# ============================================================
# Cardano Raw SDK - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env or any real credentials to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8000
NODE_ENV=production   # Set to "development" only when using self-signed certs locally

# ── Fireblocks (Required) ────────────────────────────────────
FIREBLOCKS_API_USER_KEY=<your-fireblocks-api-key>

# Secret key - provide ONE of the following:
# Option 1: Path to PEM file
FIREBLOCKS_API_USER_SECRET_KEY_PATH=<FULL/PATH/TO/fireblocks_secret.key>
# Option 2: Direct key content (PEM or base64-encoded PEM)
# FIREBLOCKS_API_USER_SECRET_KEY=-----BEGIN PRIVATE KEY-----\nMIIJ...
# FIREBLOCKS_API_USER_SECRET_KEY=TUlJSk... (base64 encoded)

# Base path for your Fireblocks workspace. Affects webhook JWKS region.
# US (default): https://api.fireblocks.io (see https://developers.fireblocks.com/reference/typescript-sdk for additional environments URLs)
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io

# ── Iagon API (Required) ─────────────────────────────────────
IAGON_API_KEY=<your-iagon-api-key>

# ── Cardano Network ──────────────────────────────────────────
# Valid values: mainnet, preprod (defaults to mainnet)
CARDANO_NETWORK=mainnet

# ── Security (Optional) ─────────────────────────────────────
# Max request body size (default: 1mb)
MAX_BODY_SIZE=1mb

# Rate limiting: requests per window (default: 100 requests per 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS: comma-separated list of allowed origins, or * for all (default: *)
CORS_ORIGINS=*

# API Key authentication (default: disabled)
# When enabled, all requests (except /health, /api-docs, /docs) require X-API-Key header
API_KEY_ENABLED=false
API_KEY=
